# Copy to .env and fill in. Never commit .env.
APP_NAME=ReplyAs
APP_HOST=replyas.example
BASE_URL=https://replyas.example
SUPPORT_EMAIL=support@replyas.example
COMPANY_NAME=Your Name / Company Ltd
COMPANY_ADDRESS=Dublin, Ireland
ADMIN_EMAILS=you@gmail.com
# Waitlist only until the relay is tested end to end:
SIGNUPS_OPEN=false
SESSION_COOKIE_SECURE=true

# python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER change after launch: it also encrypts customers' DKIM keys.
SECRET_KEY=
POSTGRES_PASSWORD=

# Mail infrastructure (see docs/DEPLOY.md)
RELAY_DOMAIN=relay.replyas.example
MX_HOST=mx.replyas.example
SMTP_HOSTNAME=mx.replyas.example
SPF_INCLUDE=spf.replyas.example
VERIFY_RECORD_PREFIX=replyas
CUSTOMER_DKIM_SELECTOR=replyas1
RELAY_DKIM_KEY_PATH=var/relay_dkim.pem
OPERATOR_EMAIL=you@gmail.com
HOSTING_PROVIDER=Hetzner Online GmbH (Germany, EU)

# Outbound delivery: direct (own IP, port 25 open) or smtp (smarthost)
OUTBOUND_MODE=direct
# SMARTHOST_HOST=
# SMARTHOST_PORT=587
# SMARTHOST_USERNAME=
# SMARTHOST_PASSWORD=
# OUTBOUND_PROVIDER=

# Limits
DAILY_SEND_LIMIT=200
DAILY_NEW_CONTACT_LIMIT=50
MAX_RECIPIENTS_PER_MESSAGE=10
TRIAL_DAYS=14
TRIAL_MAX_DOMAINS=1

# Stripe (run scripts/stripe_setup.py to create the price + webhook)
PRICE_DISPLAY=$30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false
